# Socket server the client connects to
VITE_SERVER_URL=http://localhost:3001
# "local" keeps the player's session across browser restarts (R21).
# "session" gives each tab its own player — handy for testing several players in one browser.
VITE_TOKEN_STORAGE=local
# The Turn Tables home page (header links: All Games, About us, Bugs & Fixes)
VITE_HOME_URL=http://localhost:5174
